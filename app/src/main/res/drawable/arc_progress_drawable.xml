<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background track: A full ring that will be cropped to show only the top half -->
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.5"
            android:shape="ring"
            android:thickness="12dp"
            android:useLevel="false">
            <solid android:color="@color/dividerGrey" />
        </shape>
    </item>

    <!-- Progress track: Rotated 180 degrees so it starts filling from 9 o'clock -->
    <!-- With max=200 in the ProgressBar, progress=100 will fill exactly 180 degrees (top half) -->
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="180"
            android:pivotX="50%"
            android:pivotY="50%"
            android:useLevel="false">
            <shape
                android:innerRadiusRatio="2.5"
                android:shape="ring"
                android:thickness="12dp"
                android:useLevel="true">
                <solid android:color="@color/mainAccent" />
            </shape>
        </rotate>
    </item>
</layer-list>